{
  "name": "ai-cost-to-humanity",
  "version": "1.0.0",
  "description": "AI incident search with Gemini embeddings",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run client\" \"npm run server:dev\"",
    "client": "cd client && npm run dev",
    "server:dev": "tsx watch server.ts",
    "server": "node dist/server.js",
    "build": "tsc && cd client && npm run build",
    "build:server": "tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "@google-ai/generativeai": "^0.3.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "typescript": "^5.2.2",
    "@types/node": "^20.5.0",
    "@types/express": "^4.17.17",
    "tsx": "^3.14.0"
  }
}
