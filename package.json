{
  "name": "ai-cost-to-humanity",
  "version": "1.0.0",
  "description": "AI incident search with Gemini embeddings",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run client\" \"npm run server:dev\"",
    "client": "cd client && npm run dev",
    "server:dev": "tsx watch server.ts",
    "server": "node dist/server.js",
    "start": "node dist/server.js",
    "build": "tsc && npm --prefix client install --include=dev && npm --prefix client run build:web",
    "build:server": "tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.11.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "concurrently": "^8.2.1",
    "tsx": "^3.14.0",
    "typescript": "^5.2.2"
  }
}
